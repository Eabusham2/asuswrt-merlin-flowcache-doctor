#!/bin/sh
VERSION=1.0.0-mlo-safe-auto
LIB=/jffs/scripts/fcd-lib.sh
DAEMON=/jffs/scripts/fcd-daemon.sh
EVENTS=/jffs/scripts/fcd-events.sh
CONF=/jffs/scripts/flowcache-doctor.conf
STATE=/tmp/flowcache-doctor
ROOT=/jffs/flowcache-doctor
REPO_RAW=https://raw.githubusercontent.com/Eabusham2/asuswrt-merlin-flowcache-doctor/main
[ -r "$LIB" ] && . "$LIB"

pid_alive(){ [ -n "$1" ] && [ -d "/proc/$1" ]; }
stop_one(){ _f=$1; _p=$(cat "$_f" 2>/dev/null); pid_alive "$_p" && kill "$_p" 2>/dev/null; rm -f "$_f"; }
start_all(){
  mkdir -p "$STATE"
  _p=$(cat "$STATE/daemon.pid" 2>/dev/null)
  if ! pid_alive "$_p"; then "$DAEMON" >/dev/null 2>&1 & fi
  if [ "${FCD_EVENT_HEAL:-1}" = "1" ] && [ -f /jffs/wifi_wlc.log ]; then
    _e=$(cat "$STATE/events.pid" 2>/dev/null)
    if ! pid_alive "$_e"; then "$EVENTS" >/dev/null 2>&1 & fi
  fi
}
stop_all(){ stop_one "$STATE/events.pid"; stop_one "$STATE/daemon.pid"; sleep 1; rm -rf "$STATE/daemon.lock" "$STATE/events.lock"; }

case "$1" in
  start|boot) start_all;;
  stop) stop_all;;
  restart) stop_all; start_all;;
  watchdog)
    [ -f /jffs/scripts/flowcache-doctor.disabled ] && exit 0
    start_all
    ;;
  enable) rm -f /jffs/scripts/flowcache-doctor.disabled; start_all; echo enabled;;
  disable) touch /jffs/scripts/flowcache-doctor.disabled; stop_all; echo disabled;;
  status)
    echo "version: $VERSION"
    echo "mode: automatic fail-closed"
    echo "autofix: ${FCD_AUTOFIX:-1}"
    echo "steering: ${FCD_STEER_MODE:-advisor} (never force-steers)"
    echo "non-MLO confirmations: ${FCD_CONFIRMATIONS:-5}"
    echo "log retention: ${FCD_LOG_RETENTION_DAYS:-30} days"
    _p=$(cat "$STATE/daemon.pid" 2>/dev/null); pid_alive "$_p" && echo "daemon: running (pid $_p)" || echo "daemon: stopped"
    _e=$(cat "$STATE/events.pid" 2>/dev/null); pid_alive "$_e" && echo "events: running (pid $_e)" || echo "events: stopped/unsupported"
    ;;
  health)
    _rc=0
    ok(){ echo "  ok: $*"; }; bad(){ echo "  FAIL: $*"; _rc=1; }; warn(){ echo "  warn: $*"; }
    echo "flowcache-doctor $VERSION health"
    [ "$(nvram get jffs2_scripts)" = "1" ] && ok "JFFS scripts enabled" || bad "JFFS scripts disabled"
    for _f in "$LIB" "$DAEMON" "$EVENTS" /jffs/scripts/roamctl; do [ -x "$_f" ] && ok "executable $_f" || bad "missing/not executable $_f"; done
    which fcctl >/dev/null 2>&1 && ok "fcctl available" || bad "fcctl unavailable"
    [ -f "$CONF" ] && sh -n "$CONF" >/dev/null 2>&1 && ok "config parses" || bad "config missing or invalid"
    _b=$(fcd_resolve_bsslist); [ -n "$_b" ] && ok "BSS interfaces: $_b" || bad "no roamable BSS interfaces"
    _p=$(cat "$STATE/daemon.pid" 2>/dev/null); pid_alive "$_p" && ok "daemon running" || bad "daemon not running"
    [ "${FCD_EVENT_HEAL:-1}" != "1" ] && warn "event listener disabled" || { [ ! -f /jffs/wifi_wlc.log ] && warn "firmware event log unavailable; poller still works" || { _e=$(cat "$STATE/events.pid" 2>/dev/null); pid_alive "$_e" && ok "event listener running" || bad "event listener not running"; }; }
    grep -q 'flowcache-doctor-watchdog' /jffs/scripts/services-start 2>/dev/null && ok "boot/watchdog hook installed" || bad "boot/watchdog hook missing"
    cru l 2>/dev/null | grep -q flowcache-doctor-watchdog && ok "cron watchdog armed" || bad "cron watchdog missing"
    [ "$_rc" -eq 0 ] && echo healthy || echo "problems found"
    exit "$_rc"
    ;;
  clients)
    BSSLIST=$(fcd_resolve_bsslist); MAP="$STATE/.clients.$$"; MLO="$STATE/.mlo.clients.$$"; mkdir -p "$STATE"; : > "$MAP"; : > "$MLO"
    for _b in $BSSLIST; do wl -i "$_b" assoclist 2>/dev/null | awk -v b="$_b" '{if($2!="") print tolower($2),b}' >> "$MAP"; { wl -i "$_b" mlo 2>/dev/null; wl -i "$_b" mlo_status 2>/dev/null; } >> "$MLO"; done
    FCD_ASSOC_MAP="$MAP"; FCD_MLO_SNAPSHOT="$MLO"; export FCD_ASSOC_MAP FCD_MLO_SNAPSHOT
    printf '%-18s %-22s %-28s %s\n' MAC RADIOS CLASSIFICATION CONFIRMED
    for _m in $(awk '{print $1}' "$MAP" | sort -u); do
      _r=$(awk -v m="$_m" '$1==m{printf "%s%s",s,$2;s=","}' "$MAP"); _b=$(awk -v m="$_m" '$1==m{print $2;exit}' "$MAP")
      _c=$(fcd_classify "$_m" "$_b" "$BSSLIST"); fcd_confirmed_nonmlo "$_m" "$_b" && _yes=yes || _yes=no
      printf '%-18s %-22s %-28s %s\n' "$_m" "$_r" "$_c" "$_yes"
    done
    rm -f "$MAP" "$MLO"
    ;;
  advise)
    BSSLIST=$(fcd_resolve_bsslist); MAP="$STATE/.advise.$$"; mkdir -p "$STATE"; : > "$MAP"
    for _b in $BSSLIST; do wl -i "$_b" assoclist 2>/dev/null | awk -v b="$_b" '{if($2!="") print tolower($2),b}' >> "$MAP"; done
    printf '%-18s %-12s %-8s %-12s %-8s %s\n' MAC BSS RSSI TX/RX UTIL NOTE
    for _m in $(awk '{print $1}' "$MAP" | sort -u); do
      _b=$(awk -v m="$_m" '$1==m{print $2;exit}' "$MAP"); _c=$(fcd_classify "$_m" "$_b" "$BSSLIST")
      _r=$(fcd_client_rssi "$_b" "$_m"); _rates=$(fcd_client_rates "$_b" "$_m"); _u=$(fcd_radio_util "$_b")
      case "$_c" in nonmlo-*) _note="Smart Connect owns band choice";; *) _note="protected; no steering";; esac
      printf '%-18s %-12s %-8s %-12s %-8s %s\n' "$_m" "$_b" "${_r:-?}" "$_rates" "$_u" "$_note"
    done
    rm -f "$MAP"
    ;;
  log) cat "$FCD_LOG_DIR"/events-*.log 2>/dev/null | tail -n "${2:-100}";;
  cleanup) rm -f "$STATE"/cleanup.*; fcd_cleanup_logs; echo cleaned;;
  update)
    _tmp=/tmp/fcd-install.$$
    curl -fsSL "$REPO_RAW/install.sh?cb=$(date +%s)" -o "$_tmp" || exit 1
    sh -n "$_tmp" || { rm -f "$_tmp"; exit 1; }
    exec sh "$_tmp"
    ;;
  uninstall) exec sh /jffs/scripts/flowcache-doctor-uninstall.sh;;
  *) echo "usage: roamctl start|stop|restart|status|health|clients|advise|log [lines]|cleanup|update|enable|disable|uninstall"; exit 1;;
esac
